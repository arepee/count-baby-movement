# Copy to .env.local for local dev; set the same vars in Vercel → Project → Settings → Environment Variables.
# Generate the secrets below with:  npm run vapid

# 4-digit code used to log in to the app.
APP_CODE=1234

# Random string used to sign the session cookie (HMAC key). Changing it logs everyone out.
AUTH_SECRET=

# Neon Postgres connection string. Set automatically when you add Neon via Vercel Marketplace.
DATABASE_URL=postgres://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Web Push (VAPID) keys. The public key is exposed to the browser (NEXT_PUBLIC_).
# Changing the keys invalidates existing push subscriptions (re-enable notifications on the phone).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# Bearer token the GitHub Action sends to /api/cron. Must match the CRON_SECRET GitHub repo secret.
CRON_SECRET=
